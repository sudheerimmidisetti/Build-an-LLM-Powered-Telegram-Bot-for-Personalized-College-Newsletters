# Telegram Bot API Token (Get it from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenWeatherMap API Key for fetching weather forecast
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Ollama Base URL (Use http://localhost:11434 for local, http://ollama:11434 for docker-compose)
OLLAMA_BASE_URL=http://ollama:11434

# Database Connection URL (aiosqlite prefix will be auto-appended)
DATABASE_URL=sqlite:///data/newsletter.db

# FastAPI Web Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Default weather location if user's college cannot be resolved to weather coordinates/city
WEATHER_DEFAULT_LOCATION=New York,US
